---
import BaseLayout from './BaseLayout.astro';

// Layout for standalone MDX pages (frontmatter: title, description).
const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="prose page">
    <header class="page__header">
      {frontmatter.eyebrow && <p class="eyebrow">{frontmatter.eyebrow}</p>}
      <h1 class="page__title">{frontmatter.title}</h1>
      {frontmatter.description && <p class="page__lede">{frontmatter.description}</p>}
    </header>
    <slot />
  </article>
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  .page__header {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .page__title {
    font-size: var(--step-4);
  }
  .page__lede {
    font-size: var(--step-1);
    color: var(--color-text); /* full contrast; ledes are consistent site-wide */
    line-height: var(--leading-snug);
  }
</style>
