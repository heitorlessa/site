---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  minutesRead?: number;
}
const { post, minutesRead } = Astro.props;
const { title, description, pubDate, updated, tags } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updated}
>
  <article class="post">
    <header class="post__header container">
      {
        tags.length > 0 && (
          <p class="post__tags eyebrow">
            {tags.map((t) => (
              <span>#{t}</span>
            ))}
          </p>
        )
      }
      <h1 class="post__title">{title}</h1>
      <p class="post__desc">{description}</p>
      <div class="post__meta">
        <FormattedDate date={pubDate} />
        {
          updated && (
            <span>· Updated <FormattedDate date={updated} /></span>
          )
        }
        {minutesRead && <span>· {minutesRead} min read</span>}
      </div>
    </header>

    <div class="post__body prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post__header {
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
    display: grid;
    gap: var(--space-4);
    max-width: calc(var(--measure-wide) + 2 * var(--content-pad));
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .post__title {
    font-size: var(--step-5);
  }

  .post__desc {
    font-size: var(--step-1);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
    max-width: var(--measure);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-text-subtle);
    font-size: var(--step--1);
  }

  .post__body {
    padding-bottom: var(--space-8);
  }

  /* Islands (rendered as <astro-island>) and figures get breathing room. */
  .post__body > :is(figure, astro-island) {
    display: block;
    margin-block: var(--space-7);
  }
</style>
