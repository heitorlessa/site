---
import FormattedDate from './FormattedDate.astro';
import { withBase } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const href = withBase(`/blog/${post.id}/`);
---

<article class="card">
  <a class="card__link" href={href}>
    <h2 class="card__title">{post.data.title}</h2>
  </a>
  <p class="card__desc">{post.data.description}</p>
  <div class="card__meta">
    <FormattedDate date={post.data.pubDate} />
    {
      post.data.tags.length > 0 && (
        <ul class="card__tags" aria-label="Tags">
          {post.data.tags.slice(0, 3).map((t) => (
            <li>#{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: var(--border-thin) solid var(--color-border);
  }

  .card__link {
    text-decoration: none;
    color: inherit;
    width: fit-content;
  }
  /* Stretch the title's link over the whole card so the entire row is a tap
     target (the title stays the accessible name). */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__title {
    font-size: var(--step-2);
    transition: color var(--motion-micro) var(--ease);
  }
  .card:hover .card__title {
    color: var(--color-accent);
  }
  .card__link:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .card__desc {
    color: var(--color-text-muted);
    max-width: var(--measure);
  }

  .card__meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--color-text-subtle);
    font-size: var(--step--1);
  }

  /* Metadata, not links — keep terracotta reserved for real interactivity. */
  .card__tags {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-text-subtle);
  }
</style>
