---
import { SITE_TITLE, NAV_LINKS, withBase } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
function isCurrent(href: string): boolean {
  const target = withBase(href).replace(/\/+$/, '') || '/';
  if (target === withBase('').replace(/\/+$/, '')) return here === target;
  return here === target || here.startsWith(target + '/');
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={withBase('/')}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">{SITE_TITLE}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={withBase(link.href)}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in oklab, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(1.1) blur(8px);
    border-bottom: var(--border-thin) solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: var(--weight-bold);
    text-decoration: none;
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
  }

  .brand__mark {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--color-accent-solid), var(--color-accent));
    box-shadow: inset 0 0 0 2px color-mix(in oklab, var(--color-bg) 60%, transparent);
    flex: none;
  }

  .brand:hover .brand__name {
    color: var(--color-accent);
  }

  .site-nav {
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--step--1);
    transition:
      color var(--motion-micro) var(--ease),
      background-color var(--motion-micro) var(--ease);
  }

  .site-nav a:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  @media (max-width: 30rem) {
    .brand__name {
      font-size: var(--step--1);
    }
    .site-nav a {
      padding-inline: var(--space-2);
    }
  }
</style>
