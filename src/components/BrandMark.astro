---
// Brand glyph: one node branching to two — a tiny nod to the diagrams the blog
// is built around (connected ideas / mental models). Uses currentColor so the
// caller sets the tint.
interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: className } = Astro.props;
---

<svg
  class:list={['brand-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M7.4 12 16 6.7 M7.4 12 16 17.3"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
  ></path>
  <circle cx="6" cy="12" r="3.1" fill="currentColor"></circle>
  <circle cx="17.4" cy="6.4" r="2.4" fill="currentColor" opacity="0.6"></circle>
  <circle cx="17.4" cy="17.6" r="2.4" fill="currentColor" opacity="0.6"></circle>
</svg>

<style>
  .brand-mark {
    display: block;
    flex: none;
    color: var(--color-accent-solid);
  }
</style>
