---
import { SITE_TITLE, SITE_AUTHOR, withBase } from '../consts';
import BrandMark from './BrandMark.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a class="site-footer__brand" href={withBase('/')}>
      <BrandMark size={20} />
      <span>{SITE_TITLE}</span>
    </a>
    <nav aria-label="Footer">
      <ul>
        <li><a href={withBase('/')}>Notes</a></li>
        <li><a href={withBase('/demos')}>Interactive</a></li>
        <li>
          <a href={new URL(withBase('rss.xml'), Astro.site).href}>RSS</a>
        </li>
      </ul>
    </nav>
    <p class="site-footer__fine">
      © {year} {SITE_AUTHOR}. Built for calm, accessible reading — no trackers, no noise.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-10);
    border-top: var(--border-thin) solid var(--color-border);
    background: var(--color-surface);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-6);
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--color-text);
  }
  .site-footer__brand:hover span {
    color: var(--color-accent);
  }

  .site-footer nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--step--1);
  }
  .site-footer nav a:hover {
    color: var(--color-accent);
  }

  .site-footer__fine {
    flex-basis: 100%;
    color: var(--color-text-subtle);
    font-size: var(--step--1);
  }
</style>
